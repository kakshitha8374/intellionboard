{
  "$schema": "https://raw.githubusercontent.com/microsoft/pyright/main/packages/pyright-internal/typestubs-fallback/schemas/pyrightconfig.schema.json",
  "include": [
    "."
  ],
  "exclude": [
    "repos",
    "repos/**",
    ".venv",
    ".venv/**",
    "__pycache__",
    "**/__pycache__",
    "chroma_db",
    "chroma_db/**",
    "bob_sessions",
    "bob_sessions/**",
    ".intellionboard_cache",
    ".intellionboard_cache/**",
    ".pytest_cache",
    "**/.pytest_cache",
    ".mypy_cache",
    "**/.mypy_cache",
    ".ruff_cache",
    "**/.ruff_cache",
    "build",
    "dist"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.11",
  "typeCheckingMode": "basic",
  "reportMissingImports": "warning",
  "reportMissingModuleSource": "none"
}
