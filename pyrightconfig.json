{
  "$schema": "https://raw.githubusercontent.com/microsoft/pyright/main/packages/pyright-internal/typestubs-fallback/schemas/pyrightconfig.schema.json",
  "include": [
    "backend"
  ],
  "exclude": [
    "backend/repos",
    "backend/repos/**",
    "backend/.venv",
    "backend/.venv/**",
    "backend/__pycache__",
    "backend/__pycache__/**",
    "backend/chroma_db",
    "backend/chroma_db/**",
    "backend/bob_sessions",
    "backend/bob_sessions/**",
    "backend/.intellionboard_cache",
    "backend/.intellionboard_cache/**",
    "frontend/node_modules",
    "frontend/node_modules/**",
    "frontend/dist",
    "frontend/dist/**",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/node_modules",
    "**/dist",
    "**/build"
  ],
  "venvPath": "backend",
  "venv": ".venv",
  "pythonVersion": "3.11",
  "typeCheckingMode": "basic",
  "reportMissingImports": "warning",
  "reportMissingModuleSource": "none"
}
